# Kodi add-on strings - visualization.aeonwave (el_gr)
msgid ""
msgstr ""
"Project-Id-Version: visualization.aeonwave\n"
"Language: el_GR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "#30000"
msgid "Points per line"
msgstr "Σημεία ανά γραμμή"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Από πόσα σημεία περνά η γραμμή: λιγότερα είναι πιο ήρεμα."

msgctxt "#30002"
msgid "Line color"
msgstr "Χρώμα γραμμής"

msgctxt "#30003"
msgid "Red"
msgstr "Κόκκινο"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Ένταση του κόκκινου στη γραμμή."

msgctxt "#30005"
msgid "Green"
msgstr "Πράσινο"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Ένταση του πράσινου στη γραμμή."

msgctxt "#30007"
msgid "Blue"
msgstr "Μπλε"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Ένταση του μπλε στη γραμμή."

msgctxt "#30009"
msgid "Alpha"
msgstr "Άλφα"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Ένταση του άλφα στη γραμμή."

msgctxt "#30011"
msgid "Background color"
msgstr "Χρώμα φόντου"

msgctxt "#30012"
msgid "Red"
msgstr "Κόκκινο"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Ένταση του κόκκινου στο φόντο."

msgctxt "#30014"
msgid "Green"
msgstr "Πράσινο"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Ένταση του πράσινου στο φόντο."

msgctxt "#30016"
msgid "Blue"
msgstr "Μπλε"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Ένταση του μπλε στο φόντο."

msgctxt "#30018"
msgid "Alpha"
msgstr "Άλφα"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Ένταση του άλφα στο φόντο."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Χωρίς υπολογισμό"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Πάχος γραμμής"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Ορίζει το πάχος μιας γραμμής σε pixel."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Κανάλια"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Αριστερό ή Δεξί: αυτό το κανάλι ως μία γραμμή στη μέση. Και τα δύο μιξαρισμένα: αριστερό και δεξί σε μέσο όρο σε μία γραμμή. Και τα δύο επικαλυπτόμενα: και οι δύο γραμμές στην ίδια ζώνη, η δεξιά πιο αχνή. Και τα δύο ως δύο γραμμές: αριστερό πάνω, δεξί κάτω (όπως το Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Αριστερό"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Και τα δύο μιξαρισμένα"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Και τα δύο ως δύο γραμμές"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Εξομάλυνση"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Πόσες φορές κάθε σημείο εξισώνεται με τους γείτονές του: περισσότερο είναι πιο στρογγυλό."

msgctxt "#30042"
msgid "Calm"
msgstr "Ηρεμία"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Πόσο από την προηγούμενη γραμμή μένει στην επόμενη: περισσότερο είναι πιο αργό και σταθερό."

msgctxt "#30044"
msgid "Height"
msgstr "Ύψος"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Πόσο ταλαντεύεται η γραμμή· οι δυνατές κορυφές μένουν πάντα μέσα στο πλαίσιο."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Ομαλή καμπύλη"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Μια στρογγυλεμένη καμπύλη μέσα από τα σημεία αντί για ευθείες γραμμές."

msgctxt "#30050"
msgid "Style"
msgstr "Στυλ"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Ομαλό: μια ήρεμη, στρογγυλεμένη γραμμή (κάθε σημείο ο μέσος όρος του ήχου που καλύπτει, εξισωμένος). Ακριβές: τα ακατέργαστα δείγματα, όπως τα σχεδιάζει το Waveform."

msgctxt "#30052"
msgid "Smooth"
msgstr "Ομαλό"

msgctxt "#30053"
msgid "Accurate"
msgstr "Ακριβές"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Ομαλότητα"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: τα ακατέργαστα δείγματα, όπως τα σχεδιάζει το Waveform (ακριβές, ταραγμένο). Υψηλότερα: κάθε σημείο βγάζει μέσο όρο από περισσότερο ήχο και εξισώνεται με τους γείτονες και την προηγούμενη στιγμή, οπότε η γραμμή γίνεται πιο ήρεμη και στρογγυλή. Το 10 είναι το πιο ήρεμο."

msgctxt "#30062"
msgid "Accurate"
msgstr "Ακριβές"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Δεξί"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Και τα δύο επικαλυπτόμενα"
