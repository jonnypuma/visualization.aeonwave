msgctxt "#30000"
msgid "Points per line"
msgstr "Points par ligne"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Nombre de points par lesquels passe la ligne : moins, c'est plus calme."

msgctxt "#30002"
msgid "Line color"
msgstr "Couleur de la ligne"

msgctxt "#30003"
msgid "Red"
msgstr "Rouge"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Intensité du rouge dans la ligne."

msgctxt "#30005"
msgid "Green"
msgstr "Vert"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Intensité du vert dans la ligne."

msgctxt "#30007"
msgid "Blue"
msgstr "Bleu"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Intensité du bleu dans la ligne."

msgctxt "#30009"
msgid "Alpha"
msgstr "Alpha"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Intensité de l'alpha dans la ligne."

msgctxt "#30011"
msgid "Background color"
msgstr "Couleur du fond"

msgctxt "#30012"
msgid "Red"
msgstr "Rouge"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Intensité du rouge dans le fond."

msgctxt "#30014"
msgid "Green"
msgstr "Vert"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Intensité du vert dans le fond."

msgctxt "#30016"
msgid "Blue"
msgstr "Bleu"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Intensité du bleu dans le fond."

msgctxt "#30018"
msgid "Alpha"
msgstr "Alpha"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Intensité de l'alpha dans le fond."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Ne pas calculer"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Épaisseur de la ligne"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Définit l'épaisseur d'une ligne en nombre de pixels."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Canaux"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Gauche ou Droite : ce canal comme une ligne au milieu. Les deux mélangés : gauche et droite moyennés en une ligne. Les deux superposés : les deux lignes dans la même bande, la droite plus pâle. Les deux en deux lignes : gauche en haut, droite en bas (comme Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Gauche"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Les deux mélangés"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Les deux en deux lignes"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Lissage"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Combien de fois chaque point est égalisé avec ses voisins : plus, c'est plus rond."

msgctxt "#30042"
msgid "Calm"
msgstr "Calme"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Quelle part de la ligne précédente reste dans la suivante : plus, c'est plus lent et plus stable."

msgctxt "#30044"
msgid "Height"
msgstr "Hauteur"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "L'amplitude de la ligne ; les pics forts restent de toute façon dans le cadre."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Courbe douce"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Une courbe arrondie passant par les points au lieu de lignes droites."

msgctxt "#30050"
msgid "Style"
msgstr "Style"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Doux : une ligne calme et arrondie (chaque point est la moyenne de l'audio qu'il couvre, égalisée). Précis : les échantillons bruts, comme les dessine Waveform."

msgctxt "#30052"
msgid "Smooth"
msgstr "Doux"

msgctxt "#30053"
msgid "Accurate"
msgstr "Précis"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Douceur"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0 : les échantillons bruts, comme les dessine Waveform (précis, agité). Plus haut : chaque point fait la moyenne de plus d'audio et est égalisé avec ses voisins et l'instant précédent, la ligne devient plus calme et plus ronde. 10 est le plus calme."

msgctxt "#30062"
msgid "Accurate"
msgstr "Précis"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Droite"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Les deux superposés"
