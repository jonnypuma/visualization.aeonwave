msgctxt "#30000"
msgid "Points per line"
msgstr "Body na čáru"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Kolika body čára prochází: méně je klidnější."

msgctxt "#30002"
msgid "Line color"
msgstr "Barva čáry"

msgctxt "#30003"
msgid "Red"
msgstr "Červená"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Síla červené barvy v čáře."

msgctxt "#30005"
msgid "Green"
msgstr "Zelená"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Síla zelené barvy v čáře."

msgctxt "#30007"
msgid "Blue"
msgstr "Modrá"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Síla modré barvy v čáře."

msgctxt "#30009"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Síla alfa kanálu v čáře."

msgctxt "#30011"
msgid "Background color"
msgstr "Barva pozadí"

msgctxt "#30012"
msgid "Red"
msgstr "Červená"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Síla červené barvy v pozadí."

msgctxt "#30014"
msgid "Green"
msgstr "Zelená"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Síla zelené barvy v pozadí."

msgctxt "#30016"
msgid "Blue"
msgstr "Modrá"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Síla modré barvy v pozadí."

msgctxt "#30018"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Síla alfa kanálu v pozadí."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Nepočítat"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Tloušťka čáry"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Určuje tloušťku čáry v počtu pixelů."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Kanály"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Levý nebo Pravý: tento kanál jako jedna čára středem. Oba smíchané: levý a pravý zprůměrované do jedné čáry. Oba přes sebe: obě čáry ve stejném pásu, pravá slabší. Oba jako dvě čáry: levý nahoře, pravý dole (jako Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Levý"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Oba smíchané"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Oba jako dvě čáry"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Vyhlazení"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Kolikrát se každý bod vyrovná se sousedy: více je oblejší."

msgctxt "#30042"
msgid "Calm"
msgstr "Klid"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Kolik z předchozí čáry zůstane v další: více je pomalejší a stálejší."

msgctxt "#30044"
msgid "Height"
msgstr "Výška"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Jak daleko čára kmitá; hlasité špičky zůstanou v rámečku tak jako tak."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Hladká křivka"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Zaoblená křivka přes body místo rovných čar."

msgctxt "#30050"
msgid "Style"
msgstr "Styl"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Hladký: klidná, zaoblená čára (každý bod je průměr zvuku, který pokrývá, vyrovnaný). Přesný: surové vzorky, jak je kreslí Waveform."

msgctxt "#30052"
msgid "Smooth"
msgstr "Hladký"

msgctxt "#30053"
msgid "Accurate"
msgstr "Přesný"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Hladkost"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: surové vzorky, jak je kreslí Waveform (přesné, neklidné). Vyšší: každý bod průměruje více zvuku, který pokrývá, a vyrovná se se sousedy a s předchozí chvílí, takže je čára klidnější a oblejší. 10 je nejklidnější."

msgctxt "#30062"
msgid "Accurate"
msgstr "Přesný"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Pravý"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Oba přes sebe"
