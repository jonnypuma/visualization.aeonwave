msgid ""
msgstr ""
"Project-Id-Version: visualization.aeonwave\n"
"Language: ja_JP\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgctxt "#30000"
msgid "Points per line"
msgstr "ラインあたりのポイント数"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "ラインが通るポイントの数: 少ないほど落ち着きます。"

msgctxt "#30002"
msgid "Line color"
msgstr "ラインの色"

msgctxt "#30003"
msgid "Red"
msgstr "赤"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "ラインの赤の強さ。"

msgctxt "#30005"
msgid "Green"
msgstr "緑"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "ラインの緑の強さ。"

msgctxt "#30007"
msgid "Blue"
msgstr "青"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "ラインの青の強さ。"

msgctxt "#30009"
msgid "Alpha"
msgstr "アルファ"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "ラインのアルファの強さ。"

msgctxt "#30011"
msgid "Background color"
msgstr "背景色"

msgctxt "#30012"
msgid "Red"
msgstr "赤"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "背景の赤の強さ。"

msgctxt "#30014"
msgid "Green"
msgstr "緑"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "背景の緑の強さ。"

msgctxt "#30016"
msgid "Blue"
msgstr "青"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "背景の青の強さ。"

msgctxt "#30018"
msgid "Alpha"
msgstr "アルファ"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "背景のアルファの強さ。"

msgctxt "#30020"
msgid "Don't calculate"
msgstr "計算しない"

msgctxt "#30021"
msgid "Line thickness"
msgstr "ラインの太さ"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "ラインの太さをピクセル数で指定します。"

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "チャンネル"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "左または右: そのチャンネルを中央の1本のラインで。両方をミックス: 左右を平均して1本のラインに。両方を重ねる: 両方のラインを同じ帯に、右は薄く。両方を2本のラインで: 左を上、右を下に (Waveform と同じ)。"

msgctxt "#30032"
msgid "Left"
msgstr "左"

msgctxt "#30033"
msgid "Both mixed"
msgstr "両方をミックス"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "両方を2本のラインで"

msgctxt "#30040"
msgid "Smoothing"
msgstr "スムージング"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "各ポイントを隣と均す回数: 多いほど丸くなります。"

msgctxt "#30042"
msgid "Calm"
msgstr "落ち着き"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "前のラインが次のラインにどれだけ残るか: 多いほどゆっくり安定します。"

msgctxt "#30044"
msgid "Height"
msgstr "高さ"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "ラインの振れ幅。大きなピークはどちらにしても枠内に収まります。"

msgctxt "#30046"
msgid "Smooth curve"
msgstr "滑らかな曲線"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "直線の代わりにポイントを通る丸い曲線。"

msgctxt "#30050"
msgid "Style"
msgstr "スタイル"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "スムーズ: 落ち着いた丸いライン (各ポイントは担当する音声の平均を均したもの)。正確: Waveform と同じ生のサンプル。"

msgctxt "#30052"
msgid "Smooth"
msgstr "スムーズ"

msgctxt "#30053"
msgid "Accurate"
msgstr "正確"

msgctxt "#30060"
msgid "Smoothness"
msgstr "滑らかさ"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: Waveform と同じ生のサンプル (正確だが忙しい)。高いほど: 各ポイントが担当する音声をより多く平均し、隣と直前の瞬間とで均すので、ラインが落ち着いて丸くなります。10 が最も落ち着きます。"

msgctxt "#30062"
msgid "Accurate"
msgstr "正確"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "右"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "両方を重ねる"
