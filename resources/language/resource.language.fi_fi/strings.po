msgctxt "#30000"
msgid "Points per line"
msgstr "Pisteitä viivalla"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Kuinka monen pisteen kautta viiva kulkee: vähemmän on rauhallisempi."

msgctxt "#30002"
msgid "Line color"
msgstr "Viivan väri"

msgctxt "#30003"
msgid "Red"
msgstr "Punainen"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Punaisen voimakkuus viivassa."

msgctxt "#30005"
msgid "Green"
msgstr "Vihreä"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Vihreän voimakkuus viivassa."

msgctxt "#30007"
msgid "Blue"
msgstr "Sininen"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Sinisen voimakkuus viivassa."

msgctxt "#30009"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Alfan voimakkuus viivassa."

msgctxt "#30011"
msgid "Background color"
msgstr "Taustaväri"

msgctxt "#30012"
msgid "Red"
msgstr "Punainen"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Punaisen voimakkuus taustassa."

msgctxt "#30014"
msgid "Green"
msgstr "Vihreä"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Vihreän voimakkuus taustassa."

msgctxt "#30016"
msgid "Blue"
msgstr "Sininen"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Sinisen voimakkuus taustassa."

msgctxt "#30018"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Alfan voimakkuus taustassa."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Älä laske"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Viivan paksuus"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Määrittää viivan paksuuden pikseleinä."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Kanavat"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Vasen tai Oikea: se kanava yhtenä viivana keskellä. Molemmat sekoitettuna: vasen ja oikea keskiarvona yhdeksi viivaksi. Molemmat päällekkäin: molemmat viivat samassa kaistassa, oikea himmeämpänä. Molemmat kahtena viivana: vasen ylhäällä, oikea alhaalla (kuten Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Vasen"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Molemmat sekoitettuna"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Molemmat kahtena viivana"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Tasoitus"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Kuinka usein jokainen piste tasoitetaan naapuriensa kanssa: enemmän on pyöreämpi."

msgctxt "#30042"
msgid "Calm"
msgstr "Rauhallisuus"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Kuinka paljon edellisestä viivasta jää seuraavaan: enemmän on hitaampi ja tasaisempi."

msgctxt "#30044"
msgid "Height"
msgstr "Korkeus"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Kuinka paljon viiva heilahtaa; voimakkaat huiput pysyvät joka tapauksessa laatikon sisällä."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Pehmeä käyrä"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Pyöristetty käyrä pisteiden läpi suorien viivojen sijaan."

msgctxt "#30050"
msgid "Style"
msgstr "Tyyli"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Pehmeä: rauhallinen, pyöristetty viiva (jokainen piste on kattamansa äänen keskiarvo, tasoitettuna). Tarkka: raa'at näytteet, kuten Waveform ne piirtää."

msgctxt "#30052"
msgid "Smooth"
msgstr "Pehmeä"

msgctxt "#30053"
msgid "Accurate"
msgstr "Tarkka"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Pehmeys"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: raa'at näytteet, kuten Waveform ne piirtää (tarkka, levoton). Suurempi: jokainen piste laskee keskiarvon useammasta kattamastaan äänestä ja tasoitetaan naapuriensa ja edellisen hetken kanssa, joten viiva rauhoittuu ja pyöristyy. 10 on rauhallisin."

msgctxt "#30062"
msgid "Accurate"
msgstr "Tarkka"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Oikea"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Molemmat päällekkäin"
