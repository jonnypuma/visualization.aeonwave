msgctxt "#30000"
msgid "Points per line"
msgstr "Punkter pr. linje"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Hvor mange punkter linjen går gennem: færre er roligere."

msgctxt "#30002"
msgid "Line color"
msgstr "Linjefarve"

msgctxt "#30003"
msgid "Red"
msgstr "Rød"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Styrken af rød i linjen."

msgctxt "#30005"
msgid "Green"
msgstr "Grøn"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Styrken af grøn i linjen."

msgctxt "#30007"
msgid "Blue"
msgstr "Blå"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Styrken af blå i linjen."

msgctxt "#30009"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Styrken af alfa i linjen."

msgctxt "#30011"
msgid "Background color"
msgstr "Baggrundsfarve"

msgctxt "#30012"
msgid "Red"
msgstr "Rød"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Styrken af rød i baggrunden."

msgctxt "#30014"
msgid "Green"
msgstr "Grøn"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Styrken af grøn i baggrunden."

msgctxt "#30016"
msgid "Blue"
msgstr "Blå"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Styrken af blå i baggrunden."

msgctxt "#30018"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Styrken af alfa i baggrunden."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Beregn ikke"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Linjetykkelse"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Angiver tykkelsen af en linje i antal pixels."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Kanaler"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Venstre eller Højre: den kanal som én linje gennem midten. Begge blandet: venstre og højre i gennemsnit til én linje. Begge oven på hinanden: begge linjer i samme bånd, den højre svagere. Begge som to linjer: venstre øverst, højre nederst (som Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Venstre"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Begge blandet"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Begge som to linjer"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Udjævning"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Hvor tit hvert punkt udjævnes med naboerne: mere er rundere."

msgctxt "#30042"
msgid "Calm"
msgstr "Ro"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Hvor meget af forrige linje der bliver i den næste: mere er langsommere og jævnere."

msgctxt "#30044"
msgid "Height"
msgstr "Højde"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Hvor langt linjen svinger; kraftige toppe bliver under alle omstændigheder inden for boksen."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Blød kurve"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "En afrundet kurve gennem punkterne i stedet for lige linjer."

msgctxt "#30050"
msgid "Style"
msgstr "Stil"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Blød: en rolig, afrundet linje (hvert punkt er gennemsnittet af den lyd, det dækker, udjævnet). Præcis: de rå samples, som Waveform tegner dem."

msgctxt "#30052"
msgid "Smooth"
msgstr "Blød"

msgctxt "#30053"
msgid "Accurate"
msgstr "Præcis"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Blødhed"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: de rå samples, som Waveform tegner dem (præcis, uroligt). Højere: hvert punkt tager gennemsnit af mere af lyden, det dækker, og udjævnes med naboerne og øjeblikket før, så linjen bliver roligere og rundere. 10 er roligst."

msgctxt "#30062"
msgid "Accurate"
msgstr "Præcis"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Højre"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Begge oven på hinanden"
