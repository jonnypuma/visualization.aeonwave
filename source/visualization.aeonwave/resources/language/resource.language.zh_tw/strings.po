msgid ""
msgstr ""
"Project-Id-Version: visualization.aeonwave\n"
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgctxt "#30000"
msgid "Points per line"
msgstr "每條線的點數"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "線經過多少個點：越少越平靜。"

msgctxt "#30002"
msgid "Line color"
msgstr "線條顏色"

msgctxt "#30003"
msgid "Red"
msgstr "紅"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "線條中紅色的強度。"

msgctxt "#30005"
msgid "Green"
msgstr "綠"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "線條中綠色的強度。"

msgctxt "#30007"
msgid "Blue"
msgstr "藍"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "線條中藍色的強度。"

msgctxt "#30009"
msgid "Alpha"
msgstr "透明度"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "線條中透明度的強度。"

msgctxt "#30011"
msgid "Background color"
msgstr "背景顏色"

msgctxt "#30012"
msgid "Red"
msgstr "紅"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "背景中紅色的強度。"

msgctxt "#30014"
msgid "Green"
msgstr "綠"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "背景中綠色的強度。"

msgctxt "#30016"
msgid "Blue"
msgstr "藍"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "背景中藍色的強度。"

msgctxt "#30018"
msgid "Alpha"
msgstr "透明度"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "背景中透明度的強度。"

msgctxt "#30020"
msgid "Don't calculate"
msgstr "不計算"

msgctxt "#30021"
msgid "Line thickness"
msgstr "線條粗細"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "以像素數設定線條的粗細。"

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} 像素"

msgctxt "#30030"
msgid "Channels"
msgstr "聲道"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "左或右：該聲道作為中間的一條線。兩者混合：左右平均為一條線。兩者疊加：兩條線在同一帶中，右邊較淡。兩者兩條線：左在上，右在下（同 Waveform）。"

msgctxt "#30032"
msgid "Left"
msgstr "左"

msgctxt "#30033"
msgid "Both mixed"
msgstr "兩者混合"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "兩者兩條線"

msgctxt "#30040"
msgid "Smoothing"
msgstr "平滑"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "每個點與相鄰點均衡的次數：越多越圓潤。"

msgctxt "#30042"
msgid "Calm"
msgstr "平靜"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "上一條線在下一條中保留多少：越多越慢越穩定。"

msgctxt "#30044"
msgid "Height"
msgstr "高度"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "線條擺動的幅度；響亮的峰值無論如何都留在框內。"

msgctxt "#30046"
msgid "Smooth curve"
msgstr "平滑曲線"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "用穿過各點的圓潤曲線代替直線。"

msgctxt "#30050"
msgid "Style"
msgstr "樣式"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "平滑：平靜圓潤的線（每個點是其涵蓋音訊的平均值，再加均衡）。精確：原始取樣，與 Waveform 繪製的一樣。"

msgctxt "#30052"
msgid "Smooth"
msgstr "平滑"

msgctxt "#30053"
msgid "Accurate"
msgstr "精確"

msgctxt "#30060"
msgid "Smoothness"
msgstr "平滑度"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0：原始取樣，與 Waveform 繪製的一樣（精確但雜亂）。更高：每個點平均更多涵蓋的音訊，並與相鄰點和前一時刻均衡，線條因此更平靜、更圓潤。10 最平靜。"

msgctxt "#30062"
msgid "Accurate"
msgstr "精確"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d}%"

msgctxt "#30035"
msgid "Right"
msgstr "右"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "兩者疊加"
