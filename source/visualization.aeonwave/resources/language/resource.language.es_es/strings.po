msgctxt "#30000"
msgid "Points per line"
msgstr "Puntos por línea"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Por cuántos puntos pasa la línea: menos es más tranquilo."

msgctxt "#30002"
msgid "Line color"
msgstr "Color de la línea"

msgctxt "#30003"
msgid "Red"
msgstr "Rojo"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Intensidad del rojo en la línea."

msgctxt "#30005"
msgid "Green"
msgstr "Verde"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Intensidad del verde en la línea."

msgctxt "#30007"
msgid "Blue"
msgstr "Azul"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Intensidad del azul en la línea."

msgctxt "#30009"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Intensidad del alfa en la línea."

msgctxt "#30011"
msgid "Background color"
msgstr "Color de fondo"

msgctxt "#30012"
msgid "Red"
msgstr "Rojo"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Intensidad del rojo en el fondo."

msgctxt "#30014"
msgid "Green"
msgstr "Verde"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Intensidad del verde en el fondo."

msgctxt "#30016"
msgid "Blue"
msgstr "Azul"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Intensidad del azul en el fondo."

msgctxt "#30018"
msgid "Alpha"
msgstr "Alfa"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Intensidad del alfa en el fondo."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "No calcular"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Grosor de la línea"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Define el grosor de una línea en número de píxeles."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} px"

msgctxt "#30030"
msgid "Channels"
msgstr "Canales"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Izquierdo o Derecho: ese canal como una línea por el centro. Ambos mezclados: izquierdo y derecho promediados en una línea. Ambos superpuestos: las dos líneas en la misma banda, la derecha más tenue. Ambos en dos líneas: izquierdo arriba, derecho abajo (como Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Izquierdo"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Ambos mezclados"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Ambos en dos líneas"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Suavizado"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Cuántas veces se iguala cada punto con sus vecinos: más es más redondo."

msgctxt "#30042"
msgid "Calm"
msgstr "Calma"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Cuánto de la línea anterior queda en la siguiente: más es más lento y estable."

msgctxt "#30044"
msgid "Height"
msgstr "Altura"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Cuánto oscila la línea; los picos fuertes se quedan dentro del marco de todos modos."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Curva suave"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Una curva redondeada por los puntos en lugar de líneas rectas."

msgctxt "#30050"
msgid "Style"
msgstr "Estilo"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Suave: una línea tranquila y redondeada (cada punto es el promedio del audio que cubre, igualado). Preciso: las muestras en bruto, como las dibuja Waveform."

msgctxt "#30052"
msgid "Smooth"
msgstr "Suave"

msgctxt "#30053"
msgid "Accurate"
msgstr "Preciso"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Suavidad"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: las muestras en bruto, como las dibuja Waveform (preciso, agitado). Más alto: cada punto promedia más del audio que cubre y se iguala con sus vecinos y con el instante anterior, así la línea es más tranquila y redonda. 10 es lo más tranquilo."

msgctxt "#30062"
msgid "Accurate"
msgstr "Preciso"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Derecho"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Ambos superpuestos"
