# Kodi add-on strings - visualization.aeonwave (uk_ua)
msgid ""
msgstr ""
"Project-Id-Version: visualization.aeonwave\n"
"Language: uk_UA\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgctxt "#30000"
msgid "Points per line"
msgstr "Точок на лінію"

msgctxt "#30001"
msgid "How many points the line goes through: fewer is calmer."
msgstr "Через скільки точок проходить лінія: менше — спокійніше."

msgctxt "#30002"
msgid "Line color"
msgstr "Колір лінії"

msgctxt "#30003"
msgid "Red"
msgstr "Червоний"

msgctxt "#30004"
msgid "Strength of red color in the line."
msgstr "Сила червоного кольору в лінії."

msgctxt "#30005"
msgid "Green"
msgstr "Зелений"

msgctxt "#30006"
msgid "Strength of green color in the line."
msgstr "Сила зеленого кольору в лінії."

msgctxt "#30007"
msgid "Blue"
msgstr "Синій"

msgctxt "#30008"
msgid "Strength of blue color in the line."
msgstr "Сила синього кольору в лінії."

msgctxt "#30009"
msgid "Alpha"
msgstr "Альфа"

msgctxt "#30010"
msgid "Strength of alpha in the line."
msgstr "Сила альфа-каналу в лінії."

msgctxt "#30011"
msgid "Background color"
msgstr "Колір тла"

msgctxt "#30012"
msgid "Red"
msgstr "Червоний"

msgctxt "#30013"
msgid "Strength of red color in the background."
msgstr "Сила червоного кольору в тлі."

msgctxt "#30014"
msgid "Green"
msgstr "Зелений"

msgctxt "#30015"
msgid "Strength of green color in the background."
msgstr "Сила зеленого кольору в тлі."

msgctxt "#30016"
msgid "Blue"
msgstr "Синій"

msgctxt "#30017"
msgid "Strength of blue color in the background."
msgstr "Сила синього кольору в тлі."

msgctxt "#30018"
msgid "Alpha"
msgstr "Альфа"

msgctxt "#30019"
msgid "Strength of alpha in the background."
msgstr "Сила альфа-каналу в тлі."

msgctxt "#30020"
msgid "Don't calculate"
msgstr "Не обчислювати"

msgctxt "#30021"
msgid "Line thickness"
msgstr "Товщина лінії"

msgctxt "#30022"
msgid "To define the thickness of a line with a number of pixels."
msgstr "Задає товщину лінії в пікселях."

msgctxt "#30023"
msgid "{0:d} px"
msgstr "{0:d} пікс."

msgctxt "#30030"
msgid "Channels"
msgstr "Канали"

msgctxt "#30031"
msgid "Left or Right: that channel as one line through the middle. Both mixed: left and right averaged into one line. Both overlaid: both lines in the same band, the right one dimmer. Both as two lines: left above, right below (as Waveform)."
msgstr "Лівий або Правий: цей канал однією лінією посередині. Обидва змішані: лівий і правий усереднені в одну лінію. Обидва накладені: обидві лінії в одній смузі, права блідіша. Обидва двома лініями: лівий угорі, правий унизу (як Waveform)."

msgctxt "#30032"
msgid "Left"
msgstr "Лівий"

msgctxt "#30033"
msgid "Both mixed"
msgstr "Обидва змішані"

msgctxt "#30034"
msgid "Both as two lines"
msgstr "Обидва двома лініями"

msgctxt "#30040"
msgid "Smoothing"
msgstr "Згладжування"

msgctxt "#30041"
msgid "How often each point is evened out with its neighbours: more is rounder."
msgstr "Скільки разів кожна точка вирівнюється із сусідами: більше — округліше."

msgctxt "#30042"
msgid "Calm"
msgstr "Спокій"

msgctxt "#30043"
msgid "How much of the line before stays in the next one: more is slower and steadier."
msgstr "Скільки від попередньої лінії лишається в наступній: більше — повільніше й рівніше."

msgctxt "#30044"
msgid "Height"
msgstr "Висота"

msgctxt "#30045"
msgid "How far the line swings; loud peaks stay inside the box either way."
msgstr "Наскільки сильно гойдається лінія; гучні піки в будь-якому разі лишаються в рамці."

msgctxt "#30046"
msgid "Smooth curve"
msgstr "Плавна крива"

msgctxt "#30047"
msgid "A rounded curve through the points instead of straight lines."
msgstr "Заокруглена крива через точки замість прямих ліній."

msgctxt "#30050"
msgid "Style"
msgstr "Стиль"

msgctxt "#30051"
msgid "Smooth: a calm, rounded line (each point the average of the audio it covers, evened out). Accurate: the raw samples, as Waveform draws them."
msgstr "Плавний: спокійна, заокруглена лінія (кожна точка — середнє звуку, який вона охоплює, вирівняне). Точний: сирі семпли, як їх малює Waveform."

msgctxt "#30052"
msgid "Smooth"
msgstr "Плавний"

msgctxt "#30053"
msgid "Accurate"
msgstr "Точний"

msgctxt "#30060"
msgid "Smoothness"
msgstr "Плавність"

msgctxt "#30061"
msgid "0: the raw samples, as Waveform draws them (accurate, busy). Higher: each point averages more of the audio it covers and is evened out with its neighbours and the moment before, so the line gets calmer and rounder. 10 is the calmest."
msgstr "0: сирі семпли, як їх малює Waveform (точно, неспокійно). Вище: кожна точка усереднює більше охопленого звуку й вирівнюється із сусідами та попередньою миттю, тож лінія стає спокійнішою й округлішою. 10 — найспокійніша."

msgctxt "#30062"
msgid "Accurate"
msgstr "Точний"

msgctxt "#30063"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#30035"
msgid "Right"
msgstr "Правий"

msgctxt "#30036"
msgid "Both overlaid"
msgstr "Обидва накладені"
